# Server Configuration
PORT=5000
NODE_ENV=development

# Blockchain Network Configuration (Anvil Local Node default)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Pinata IPFS Credentials
# Register a free account at https://app.pinata.cloud/
# Go to API Keys -> "New Key" -> Admin -> Create Key
#
# Option A (Recommended): Use Pinata JWT Token
PINATA_JWT=
#
# Option B: Use Pinata API Key & Secret
PINATA_API_KEY=
PINATA_API_SECRET=
#
# Dedicated or Public Gateway (default: public gateway)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
